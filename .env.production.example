# Bloom production environment template.
# Copy to .env.production or your deployment secret store. Never commit real values.

APP_ENV=production
PROVIDER_MODE=mock
APP_SECRET=replace-with-a-generated-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=3600

MINIMUM_GROUP_SIZE=5
AGGREGATION_WINDOW_MS=300000
CONTEXT_PADDING_MS=30000
MAX_CONTEXT_PADDING_MS=120000
MIN_MISSED_WINDOW_MS=30000
PHONE_SUPPORT_CONFIDENCE=0.5
PHONE_LOOKING_DOWN_MS=20000
PHONE_UNFOCUSED_ABSENT_MS=15000
MAX_BATCH_EVENTS=50
MAX_BATCH_CHUNKS=200
MAX_TRANSCRIPT_TEXT_CHARS=4000

MONGODB_URL=mongodb://replace-with-production-host:27017/bloom
REDIS_URL=redis://replace-with-production-host:6379/0
BLOOM_BACKEND_URL=https://replace-with-backend-origin.example.com

# Required only when PROVIDER_MODE=live.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
