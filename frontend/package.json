{
  "name": "bloom-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Bloom Electron desktop app with a Python FastAPI backend.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && cp index.html dist/ && cp src/renderer/styles.css dist/ && cp -R src/assets dist/",
    "dev": "npm run build && electron .",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/**/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "electron": "^38.1.0",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.mendezcarl.bloom",
    "productName": "Bloom",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons"
      }
    ],
    "mac": {
      "icon": "build/bloom-icon.icns",
      "category": "public.app-category.education"
    },
    "win": {
      "icon": "build/bloom-icon.ico"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Education"
    }
  }
}
