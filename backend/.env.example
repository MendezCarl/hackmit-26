# Backend-only local environment template.
# The root .env.example has the same values for full-stack development.

APP_ENV=development
PROVIDER_MODE=mock
APP_SECRET=dev-only-secret-change-me-before-production
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=3600

MINIMUM_GROUP_SIZE=5
AGGREGATION_WINDOW_MS=300000
CONTEXT_PADDING_MS=30000
MAX_CONTEXT_PADDING_MS=120000
MIN_MISSED_WINDOW_MS=30000
PHONE_SUPPORT_CONFIDENCE=0.5
PHONE_LOOKING_DOWN_MS=20000
PHONE_UNFOCUSED_ABSENT_MS=15000
MAX_BATCH_EVENTS=50
MAX_BATCH_CHUNKS=200
MAX_TRANSCRIPT_TEXT_CHARS=4000

MONGODB_URL=mongodb://127.0.0.1:27017/bloom
REDIS_URL=redis://127.0.0.1:6379/0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Zoom Realtime Media Streams (transcript only). Leave blank to disable.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_WEBHOOK_TOLERANCE_SECONDS=300
