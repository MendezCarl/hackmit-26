{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Separate, revocable permission for bounded text to the chosen AI provider.",
  "properties": {
    "is_allowed": {
      "title": "Is Allowed",
      "type": "boolean"
    },
    "provider": {
      "default": "openai",
      "enum": [
        "openai",
        "meta_muse"
      ],
      "title": "Provider",
      "type": "string"
    }
  },
  "required": [
    "is_allowed"
  ],
  "title": "ExternalTextConsent",
  "type": "object"
}
