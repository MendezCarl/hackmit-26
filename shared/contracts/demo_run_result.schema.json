    },
    "professor_summary": {
      "$ref": "#/$defs/ProfessorSummary",
      "description": "Anonymous professor summary for the run."
    },
    "professor_summary_suppressed": {
      "$ref": "#/$defs/ProfessorSummary",
      "description": "Summary demonstrating small-group suppression."
    },
    "recovery_card": {
      "$ref": "#/$defs/RecoveryCard",
