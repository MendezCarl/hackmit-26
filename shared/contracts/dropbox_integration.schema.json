{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "Stable error fields without echoed input, tokens, or transcript text.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "Standard repository error envelope.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "description": "Realtime envelope whose payload is validated by its concrete event model.",
      "properties": {
        "event_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "transcript.batch.accepted",
            "error.occurred"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/Receipt"
            },
            {
              "$ref": "#/$defs/ErrorResponse"
            }
          ],
          "title": "Payload"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_number": {
          "minimum": 0,
          "title": "Sequence Number",
          "type": "integer"
        },
        "session_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "session_id",
        "occurred_at",
        "sequence_number",
        "payload"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "ExportReceipt": {
      "additionalProperties": false,
      "description": "Actual provider response or an explicitly labeled synthetic receipt.",
      "properties": {
        "artifact_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "provider_mode": {
          "enum": [
            "mock",
            "live"
          ],
          "title": "Provider Mode",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "file_path",
        "revision",
        "provider_mode"
      ],
      "title": "ExportReceipt",
      "type": "object"
    },
    "ExportRequest": {
      "additionalProperties": false,
      "description": "Explicit export selection; existing provider files are never overwritten.",
      "properties": {
        "artifact_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "confirmed": {
          "const": true,
          "title": "Confirmed",
          "type": "boolean"
        },
        "filename": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}\\.md$",
          "title": "Filename",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "filename",
        "confirmed"
      ],
      "title": "ExportRequest",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "description": "Authorized text-file metadata, without file content.",
      "properties": {
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "file_path",
        "size_bytes",
        "revision"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "FilePage": {
      "additionalProperties": false,
      "description": "Provider listing capped at 100 files; cursor remains scoped to a linked folder.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "title": "Files",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "files"
      ],
      "title": "FilePage",
      "type": "object"
    },
    "FolderReceipt": {
      "additionalProperties": false,
      "description": "The selected folder and whether operations are simulated.",
      "properties": {
        "folder_path": {
          "title": "Folder Path",
          "type": "string"
        },
        "provider_mode": {
          "enum": [
            "mock",
            "live"
          ],
          "title": "Provider Mode",
          "type": "string"
        }
      },
      "required": [
        "folder_path",
        "provider_mode"
      ],
      "title": "FolderReceipt",
      "type": "object"
    },
    "FolderSelection": {
      "additionalProperties": false,
      "description": "Explicitly select a non-root folder in the authenticated user's Dropbox.",
      "properties": {
        "confirmed": {
          "const": true,
          "title": "Confirmed",
          "type": "boolean"
        },
        "folder_path": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Folder Path",
          "type": "string"
        }
      },
      "required": [
        "folder_path",
        "confirmed"
      ],
      "title": "FolderSelection",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "description": "Bounded supporting text with its provider revision and source reference.",
      "properties": {
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "text": {
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "revision",
        "text"
      ],
      "title": "Material",
      "type": "object"
    },
    "MaterialRequest": {
      "additionalProperties": false,
      "description": "Read only a selected UTF-8 .txt or .md file inside the linked folder.",
      "properties": {
        "file_path": {
          "maxLength": 500,
          "minLength": 2,
          "title": "File Path",
          "type": "string"
        }
      },
      "required": [
        "file_path"
      ],
      "title": "MaterialRequest",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "description": "Batch result: accepted writes, exact retries, and current session revision.",
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "integer"
        },
        "duplicates": {
          "title": "Duplicates",
          "type": "integer"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "accepted",
        "duplicates",
        "revision"
      ],
      "title": "Receipt",
      "type": "object"
    }
  },
  "$id": "urn:lumina:dropbox_integration:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumina dropbox_integration contracts"
}
