{
  "$defs": {
    "GroundedFact": {
      "additionalProperties": false,
      "description": "A claim and an exact evidence quote from a selected transcript chunk.",
      "properties": {
        "chunk_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Chunk Id",
          "type": "string"
        },
        "evidence_quote": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "chunk_id",
        "evidence_quote"
      ],
      "title": "GroundedFact",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "description": "Teaching suggestion tied to a released report bucket; never a student diagnosis.\n\n``topic``, ``medium`` and ``evidence`` are present only when the lecture\ntranscript for the interval was analyzed; every evidence quote must occur in\na supplied transcript chunk, so the professor can verify the observation.",
      "properties": {
        "end_ms": {
          "maximum": 28800000,
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GroundedFact"
          },
          "maxItems": 3,
          "title": "Evidence",
          "type": "array"
        },
        "medium": {
          "anyOf": [
            {
              "enum": [
                "explanation",
                "pace",
                "example",
                "terminology"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medium"
        },
        "observation": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "start_ms": {
          "maximum": 28800000,
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "suggested_action": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Suggested Action",
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "observation",
        "suggested_action"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RecommendationReview": {
      "additionalProperties": false,
      "description": "Professor feedback on a revision-bound suggestion.",
      "properties": {
        "recommendation_index": {
          "maximum": 4,
          "minimum": 0,
          "title": "Recommendation Index",
          "type": "integer"
        },
        "report_revision": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Report Revision",
          "type": "string"
        },
        "status": {
          "enum": [
            "reviewed",
            "dismissed",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "report_revision",
        "recommendation_index",
        "status"
      ],
      "title": "RecommendationReview",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Recommendations retain report revision, provider provenance and uncertainty.",
  "properties": {
    "evidence_note": {
      "anyOf": [
        {
          "maxLength": 400,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Note"
    },
    "evidence_scope": {
      "default": "intervals_only",
      "enum": [
        "intervals_only",
        "lecture_transcript"
      ],
      "title": "Evidence Scope",
      "type": "string"
    },
    "provider_mode": {
      "enum": [
        "mock",
        "live"
      ],
      "title": "Provider Mode",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "report_revision": {
      "title": "Report Revision",
      "type": "string"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/RecommendationReview"
      },
      "maxItems": 5,
      "title": "Reviews",
      "type": "array"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "available",
        "insufficient_evidence"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "report_revision",
    "status",
    "provider_mode",
    "recommendations"
  ],
  "title": "RecommendationReport",
  "type": "object"
}
