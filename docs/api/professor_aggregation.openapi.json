{
  "components": {
    "schemas": {
      "DemoStatus": {
        "additionalProperties": false,
        "description": "Synthetic lecture lifecycle receipt.",
        "properties": {
          "is_ended": {
            "title": "Is Ended",
            "type": "boolean"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "is_ended"
        ],
        "title": "DemoStatus",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "Stable error fields without echoed input, tokens, or transcript text.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Standard repository error envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "description": "Local process liveness, not external-provider readiness.",
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthStatus",
        "type": "object"
      },
      "ProfessorSummary": {
        "additionalProperties": false,
        "description": "Post-lecture aggregates, not an attention/comprehension assessment.",
        "properties": {
          "aggregation_window_ms": {
            "title": "Aggregation Window Ms",
            "type": "integer"
          },
          "highest_signal_intervals": {
            "items": {
              "$ref": "#/components/schemas/SummaryBucket"
            },
            "title": "Highest Signal Intervals",
            "type": "array"
          },
          "minimum_group_size": {
            "title": "Minimum Group Size",
            "type": "integer"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "available",
              "suppressed"
            ],
            "title": "Status",
            "type": "string"
          },
          "suggested_actions": {
            "items": {
              "type": "string"
            },
            "title": "Suggested Actions",
            "type": "array"
          },
          "timeline_buckets": {
            "items": {
              "$ref": "#/components/schemas/SummaryBucket"
            },
            "title": "Timeline Buckets",
            "type": "array"
          }
        },
        "required": [
          "session_id",
          "status",
          "minimum_group_size",
          "aggregation_window_ms",
          "policy_version",
          "timeline_buckets",
          "highest_signal_intervals",
          "suggested_actions"
        ],
        "title": "ProfessorSummary",
        "type": "object"
      },
      "SummaryBucket": {
        "additionalProperties": false,
        "description": "Fixed bucket; suppressed buckets reveal neither counts nor signal ratios.",
        "properties": {
          "end_ms": {
            "description": "Exclusive lecture-relative end.",
            "maximum": 28800000.0,
            "minimum": 0.0,
            "title": "End Ms",
            "type": "integer"
          },
          "is_suppressed": {
            "title": "Is Suppressed",
            "type": "boolean"
          },
          "participant_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Participant Count"
          },
          "possible_missed_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Possible Missed Ratio"
          },
          "start_ms": {
            "description": "Inclusive lecture-relative start.",
            "maximum": 28800000.0,
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "integer"
          }
        },
        "required": [
          "start_ms",
          "end_ms",
          "is_suppressed"
        ],
        "title": "SummaryBucket",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Host-issued bearer token; session membership and consent are checked on every request.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Synthetic identities and providers. Only features installed in this checkout are registered.",
    "title": "Lumina isolated backend features",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/sessions/{session_id}/demo/end": {
      "post": {
        "description": "Synthetic demo only: end the fixture lecture using the demo professor credential.",
        "operationId": "end_demo_api_v1_sessions__session_id__demo_end_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid interval, identifiers, or feature request."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid host bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session access, role, consent, or selected-folder scope denied."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authorized resource not found."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflicting revision or invalid session state."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body, batch, or feature storage capacity exceeded."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Only bounded JSON and supported derived text are accepted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid typed payload; supplied values are never echoed."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Provider failure; external details are redacted."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Required host dependency or approved privacy policy is unavailable."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "End Demo",
        "tags": [
          "demo"
        ]
      }
    },
    "/api/v1/sessions/{session_id}/professor-summary": {
      "get": {
        "description": "Professor bearer membership required. Only ended sessions and approved aggregation policies are supported. Fixed small-group buckets return null counts/ratios. No student identity or individual history appears. Returns 403/409/503 for denied role, active lecture, or missing policy.",
        "operationId": "read_summary_api_v1_sessions__session_id__professor_summary_get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfessorSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid interval, identifiers, or feature request."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid host bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session access, role, consent, or selected-folder scope denied."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authorized resource not found."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflicting revision or invalid session state."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body, batch, or feature storage capacity exceeded."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Only bounded JSON and supported derived text are accepted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid typed payload; supplied values are never echoed."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Provider failure; external details are redacted."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Required host dependency or approved privacy policy is unavailable."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read an anonymous post-lecture summary",
        "tags": [
          "professor"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Return process liveness without checking external services.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
