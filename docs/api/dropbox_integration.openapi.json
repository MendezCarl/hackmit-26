{
  "components": {
    "schemas": {
      "DemoStatus": {
        "additionalProperties": false,
        "description": "Synthetic lecture lifecycle receipt.",
        "properties": {
          "is_ended": {
            "title": "Is Ended",
            "type": "boolean"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "is_ended"
        ],
        "title": "DemoStatus",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "Stable error fields without echoed input, tokens, or transcript text.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Standard repository error envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExportReceipt": {
        "additionalProperties": false,
        "description": "Actual provider response or an explicitly labeled synthetic receipt.",
        "properties": {
          "artifact_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Artifact Id",
            "type": "string"
          },
          "file_path": {
            "title": "File Path",
            "type": "string"
          },
          "provider_mode": {
            "enum": [
              "mock",
              "live"
            ],
            "title": "Provider Mode",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "file_path",
          "revision",
          "provider_mode"
        ],
        "title": "ExportReceipt",
        "type": "object"
      },
      "ExportRequest": {
        "additionalProperties": false,
        "description": "Explicit export selection; existing provider files are never overwritten.",
        "properties": {
          "artifact_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Artifact Id",
            "type": "string"
          },
          "confirmed": {
            "const": true,
            "title": "Confirmed",
            "type": "boolean"
          },
          "filename": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}\\.md$",
            "title": "Filename",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "filename",
          "confirmed"
        ],
        "title": "ExportRequest",
        "type": "object"
      },
      "FileEntry": {
        "additionalProperties": false,
        "description": "Authorized text-file metadata, without file content.",
        "properties": {
          "file_path": {
            "title": "File Path",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "file_path",
          "size_bytes",
          "revision"
        ],
        "title": "FileEntry",
        "type": "object"
      },
      "FilePage": {
        "additionalProperties": false,
        "description": "Provider listing capped at 100 files; cursor remains scoped to a linked folder.",
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            },
            "title": "Files",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "files"
        ],
        "title": "FilePage",
        "type": "object"
      },
      "FolderReceipt": {
        "additionalProperties": false,
        "description": "The selected folder and whether operations are simulated.",
        "properties": {
          "folder_path": {
            "title": "Folder Path",
            "type": "string"
          },
          "provider_mode": {
            "enum": [
              "mock",
              "live"
            ],
            "title": "Provider Mode",
            "type": "string"
          }
        },
        "required": [
          "folder_path",
          "provider_mode"
        ],
        "title": "FolderReceipt",
        "type": "object"
      },
      "FolderSelection": {
        "additionalProperties": false,
        "description": "Explicitly select a non-root folder in the authenticated user's Dropbox.",
        "properties": {
          "confirmed": {
            "const": true,
            "title": "Confirmed",
            "type": "boolean"
          },
          "folder_path": {
            "maxLength": 500,
            "minLength": 2,
            "title": "Folder Path",
            "type": "string"
          }
        },
        "required": [
          "folder_path",
          "confirmed"
        ],
        "title": "FolderSelection",
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "description": "Local process liveness, not external-provider readiness.",
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthStatus",
        "type": "object"
      },
      "Material": {
        "additionalProperties": false,
        "description": "Bounded supporting text with its provider revision and source reference.",
        "properties": {
          "file_path": {
            "title": "File Path",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "text": {
            "maxLength": 100000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "file_path",
          "revision",
          "text"
        ],
        "title": "Material",
        "type": "object"
      },
      "MaterialRequest": {
        "additionalProperties": false,
        "description": "Read only a selected UTF-8 .txt or .md file inside the linked folder.",
        "properties": {
          "file_path": {
            "maxLength": 500,
            "minLength": 2,
            "title": "File Path",
            "type": "string"
          }
        },
        "required": [
          "file_path"
        ],
        "title": "MaterialRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Host-issued bearer token; session membership and consent are checked on every request.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Synthetic identities and providers. Only features installed in this checkout are registered.",
    "title": "Lumina isolated backend features",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/sessions/{session_id}/demo/end": {
      "post": {
        "description": "Synthetic demo only: end the fixture lecture using the demo professor credential.",
        "operationId": "end_demo_api_v1_sessions__session_id__demo_end_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid interval, identifiers, or feature request."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid host bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session access, role, consent, or selected-folder scope denied."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authorized resource not found."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflicting revision or invalid session state."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body, batch, or feature storage capacity exceeded."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Only bounded JSON and supported derived text are accepted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid typed payload; supplied values are never echoed."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Provider failure; external details are redacted."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Required host dependency or approved privacy policy is unavailable."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "End Demo",
        "tags": [
          "demo"
        ]
      }
    },
