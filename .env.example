# Bloom local environment configuration.
# Copy to .env (gitignored) and adjust as needed. Never commit real secrets.

# development | test | demo | production
APP_ENV=development

# mock produces deterministic synthetic cards; live is not implemented yet.
PROVIDER_MODE=mock

# JWT signing secret. Must be replaced in production.
APP_SECRET=dev-only-secret-change-me-before-production

# JWT configuration
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=3600

# Privacy and aggregation thresholds (clearly labeled synthetic demo values;
# real reporting stays disabled until the team approves the policy).
MINIMUM_GROUP_SIZE=5
AGGREGATION_WINDOW_MS=300000

# Recovery context retrieval.
CONTEXT_PADDING_MS=30000
MAX_CONTEXT_PADDING_MS=120000

# Configurable missed-window rule.
MIN_MISSED_WINDOW_MS=30000

# Optional phone-observation weak-signal thresholds.
PHONE_SUPPORT_CONFIDENCE=0.5
PHONE_LOOKING_DOWN_MS=20000
PHONE_UNFOCUSED_ABSENT_MS=15000

# Ingestion limits.
MAX_BATCH_EVENTS=50
MAX_BATCH_CHUNKS=200
MAX_TRANSCRIPT_TEXT_CHARS=4000

# Storage (used once the real Mongo/Redis integration gate is met).
MONGODB_URL=mongodb://127.0.0.1:27017/bloom
REDIS_URL=redis://127.0.0.1:6379/0

# Electron frontend.
BLOOM_BACKEND_URL=http://127.0.0.1:8000

# Optional live AI provider. Leave empty for deterministic mock behavior.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
